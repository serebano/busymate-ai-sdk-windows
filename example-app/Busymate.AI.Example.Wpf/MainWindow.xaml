<Window x:Class="Busymate.AI.Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:busymate="clr-namespace:Busymate.AI.Wpf;assembly=Busymate.AI"
        Title="Busymate SDK example" Width="1200" Height="800" MinWidth="800" MinHeight="560">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Assistant" />
                    <TextBox x:Name="AssistantBox" Margin="0,2,0,8" />
                    <TextBlock Text="Chat URL" />
                    <TextBox x:Name="ChatUrlBox" Margin="0,2,0,8" />
                    <TextBlock Text="Locale" />
                    <TextBox x:Name="LocaleBox" Margin="0,2,0,8" />
                    <TextBlock Text="Exact origins (comma-separated)" />
                    <TextBox x:Name="OriginsBox" Margin="0,2,0,8" />
                    <TextBlock Text="Identity" FontWeight="SemiBold" Margin="0,4,0,2" />
                    <RadioButton x:Name="GuestRadio" GroupName="Identity" Content="Guest (no identity bridge)" />
                    <RadioButton x:Name="IdentityRadio" GroupName="Identity" Content="Identity bridge with backend mint callback" Margin="0,2,0,6" />
                    <TextBlock Text="Authenticated backend mint URL" />
                    <TextBox x:Name="BackendUrlBox" Margin="0,2,0,8" />
                    <TextBlock Text="Account ID" />
                    <TextBox x:Name="AccountIdBox" Margin="0,2,0,8" />
                    <TextBlock Text="Backend session bearer (optional)" />
                    <PasswordBox x:Name="BearerBox" Margin="0,2,0,8" />
                    <CheckBox x:Name="MicrophoneCheck" Content="Native microphone adapter" Margin="0,2" />
                    <CheckBox x:Name="ConfirmCheck" Content="Ask with a native dialog after the tap" Margin="0,2" />
                    <CheckBox x:Name="CloseCheck" Content="Handle close action" Margin="0,2" />
                    <CheckBox x:Name="ActionsCheck" Content="Handle ready action" Margin="0,2" />
                    <CheckBox x:Name="RestrictCheck" Content="Restrict navigation to trusted origins" Margin="0,2,0,8" />
                    <Button Content="Apply settings / recreate WebView" Click="Apply_Click" Margin="0,2" Padding="6,3" />
                    <Button Content="Sign in using configured app session" Click="SignIn_Click" Margin="0,2" Padding="6,3" />
                    <Button Content="Sign out / clear verified identity" Click="SignOut_Click" Margin="0,2" Padding="6,3" />
                    <Button Content="Notify account changed / refresh state" Click="AccountChanged_Click" Margin="0,2" Padding="6,3" />
                    <Button Content="Reload chat" Click="Reload_Click" Margin="0,2" Padding="6,3" />
                    <Button Content="Open Windows microphone privacy settings" Click="Privacy_Click" Margin="0,2" Padding="6,3" />
                    <Button Content="Reset demo (guest / defaults)" Click="Reset_Click" Margin="0,2" Padding="6,3" />
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Callbacks log (no tokens, nonces, account ids or audio)" FontWeight="SemiBold" />
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
            </DockPanel>
        </Grid>
        <Grid Grid.Column="1">
            <busymate:BusymateChatView x:Name="Chat" />
            <StackPanel x:Name="ClosedPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="The chat asked the host to close." Margin="0,0,0,8" />
                <Button Content="Reopen chat" Click="Reopen_Click" Padding="8,4" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
